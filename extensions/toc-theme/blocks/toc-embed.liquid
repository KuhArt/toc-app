{% comment %}
  App embed block: loads on blog article pages
{% endcomment %}

{% assign cfg = app.metafields.toc.config.value %}

<script id="toc-config" type="application/json">
  {{ cfg | json }}
</script>

{% schema %}
{
  "name": "Table of contents",
  "target": "body",
  "enabled_on": { "templates": ["article"] },
  "stylesheet": "toc.css",
  "javascript": "toc.js",
  "settings": []
}
{% endschema %}
